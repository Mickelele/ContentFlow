# Skopiuj do .env.local i uzupełnij wartościami z Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Tylko po stronie serwera (omija RLS) — używany do wysyłki na Slacka
SUPABASE_SECRET_KEY=sb_secret_...

# Google: Dysk (Picker) i eksport do Google Docs — zob. docs/KONFIGURACJA.md
NEXT_PUBLIC_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_API_KEY=AIza...
NEXT_PUBLIC_GOOGLE_APP_ID=123456789012

# Pomocnik AI — klucz z Claude Console (tylko serwer)
ANTHROPIC_API_KEY=sk-ant-api...

# Powiadomienia push — klucze: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=https://twoja-domena
# Sekret wywołań /api/cron/reminders (długi losowy ciąg)
CRON_SECRET=...
